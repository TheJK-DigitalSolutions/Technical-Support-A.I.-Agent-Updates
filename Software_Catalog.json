  "eol": [
    {
      "id": "eol-office",
      "slug": "office",
      "name": "Microsoft Office",
      "match": [
        "^Microsoft Office (Professional|Standard|Home|Small Business|Enterprise|Basic|Plus|Ultimate).*(20\\d\\d)",
        "^Microsoft Office (20\\d\\d)"
