    {
      "id": "up-temurin-8",
      "name": "Eclipse Temurin 8 (JRE)",
      "kind": "msi",
      "product": "java",
      "fromMatch": [
        "^Java(\\(TM\\))? ",
        "^Java \\d",
        "OpenJDK",
        "Eclipse Temurin",
        "AdoptOpenJDK",
        "Zulu",
        "Corretto"
      ],
      "fromMajor": 8,
      "majorFromVersion": "^(?:1\\.)?(\\d+)",
      "sameMajorOnly": true,
      "url": "https://api.adoptium.net/v3/installer/latest/8/ga/windows/x64/jre/hotspot/normal/eclipse",
      "allowedHosts": [
        "api.adoptium.net",
        "github.com",
        "objects.githubusercontent.com",
        "release-assets.githubusercontent.com"
      ],
      "allowedPathPrefixes": {
        "github.com": [
          "/adoptium/"
        ]
      },
      "signer": "Eclipse Foundation",
      "silentArgs": [
